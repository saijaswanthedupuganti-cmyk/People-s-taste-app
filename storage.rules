rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Post photos - author-scoped write, public read (mirrors firestore.rules for recommendations).
    match /recs/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
